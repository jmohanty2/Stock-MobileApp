<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: Forced Deep Dark Midnight Navy Theme -->
    <style name="Base.Theme.PersonalStockTracker" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="colorPrimary">@color/royal_blue_primary</item>
        <item name="colorSecondary">@color/gold_yellow_accent</item>
        <item name="colorPrimaryContainer">@color/royal_blue_container</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="materialButtonStyle">@style/Widget.App.Button</item>
    </style>

    <style name="Theme.PersonalStockTracker" parent="Base.Theme.PersonalStockTracker" />

    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="cornerSize">20dp</item>
        <item name="backgroundTint">@color/royal_blue_primary</item>
    </style>

    <style name="Widget.App.Button.Gold" parent="Widget.Material3.Button">
        <item name="cornerSize">20dp</item>
        <item name="backgroundTint">@color/gold_yellow_accent</item>
        <item name="android:textColor">#0F172A</item>
    </style>

    <!-- Dark Sleek Floating Bottom Navigation View Style -->
    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/app_bg</item>
        <item name="itemIconTint">@color/bottom_nav_selector</item>
        <item name="itemTextColor">@color/bottom_nav_selector</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNavActiveIndicator</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.App.BottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#1E2B48</item>
    </style>
</resources>
